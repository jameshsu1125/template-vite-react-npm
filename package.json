{
  "name": "template-vite-react-npm",
  "private": false,
  "description": "xxxxx",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "lesca"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./standalone": {
      "types": "./lib/standalone.d.ts",
      "import": "./lib/standalone.js",
      "require": "./lib/standalone.cjs"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "dev:standalone": "VITE_DEMO_MODE=standalone vite --host",
    "build": "tsc -b && vite build && vite build --mode standalone",
    "lint": "eslint .",
    "preview": "vite preview",
    "rm": "rm -rf node_modules/ dist/ package-lock.json"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "path": "^0.12.7",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.1.0"
  }
}
